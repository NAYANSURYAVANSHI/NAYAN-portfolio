generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  title       String
  bio         String
  email       String
  github      String?
  linkedin    String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  category    String   // e.g., "Full Stack", "Languages", "AI & LLM"
  name        String
  createdAt   DateTime @default(now())
}

model Experience {
  id          String   @id @default(cuid())
  role        String
  company     String
  duration    String
  description String   // Store as JSON or simple text
  createdAt   DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String   // Comma separated or JSON string
  repoUrl     String?
  liveUrl     String?
  createdAt   DateTime @default(now())
}